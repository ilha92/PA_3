# Configuration unique pour Docker Compose et Laravel.
# Copier ce fichier en `.env` avant `docker compose up`.

# Application Laravel
APP_NAME=Replay
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
SESSION_DRIVER=file
SESSION_DOMAIN=localhost
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173,localhost:8000,127.0.0.1:8000

# Base PostgreSQL (DB_HOST=db pour la communication entre conteneurs)
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=replay
DB_USERNAME=replay
DB_PASSWORD=replay

# Port PostgreSQL expose sur la machine hote
POSTGRES_PORT=5436

# Ports exposes sur la machine hote
BACKEND_PORT=8000
FRONTEND_PORT=5173

# URLs utilisees par les deux applications
FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:8000/api

# Apres le premier demarrage, generer la cle Laravel :
# docker compose exec backend php artisan key:generate

# Catalogue IGDB : application gratuite sur https://dev.twitch.tv/console
TWITCH_CLIENT_ID=4pss86zmj12kj4cl61a8fx07hw3e0v
