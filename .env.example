# Variables lues par Docker Compose. Copier ce fichier en `.env` avant `docker compose up`.

# Base de donnees PostgreSQL
POSTGRES_DB=replay
POSTGRES_USER=replay
POSTGRES_PASSWORD=replay
POSTGRES_PORT=5432

# Ports exposes sur la machine hote
BACKEND_PORT=8000
FRONTEND_PORT=5173

# URLs utilisees par les deux applications
FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:8000/api
